---
import type { GridSection } from "@/types/hygraph";
import { cn } from "@/lib/utils";

interface Props {
  section: GridSection;
}

const { section } = Astro.props;
const columnCount = section?.columns?.length ?? 0;
const gridClass =
  columnCount <= 1
    ? "grid-cols-1"
    : columnCount % 2 === 0
      ? "md:grid-cols-2"
      : columnCount % 3 === 0
        ? "md:grid-cols-3"
        : "md:grid-cols-2 lg:grid-cols-3";
---

<section class="py-12 px-2">
  <div
    class={cn(
      "max-w-7xl mx-auto",
      columnCount > 1 &&
        "px-4 sm:px-6 lg:px-8 bg-card shadow-sm border p-4 rounded-lg"
    )}
  >
    {
      section.heading ? (
        <h2 class="text-4xl font-bold mb-6 text-festival-brown">
          {section.heading}
        </h2>
      ) : null
    }
    <div class={`grid grid-cols-1 gap-8 ${gridClass}`}>
      {
        section.columns?.map((column) => (
          <div class="flex flex-col items-start gap-4 ">
            {column.image ? (
              <img
                src={column.image.url}
                alt=""
                width={column.image.width}
                height={column.image.height}
                class="h-6 w-auto"
                loading="lazy"
                decoding="async"
              />
            ) : null}
            <div
              set:html={column.content?.html}
              class="prose lg:prose-lg xl:prose-xl max-w-none"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>
