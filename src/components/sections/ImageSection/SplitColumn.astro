---
import type { HygraphImage, HygraphButton } from "@/types/hygraph";
import { buttonVariants } from "@/components/Button.astro";

interface Props {
  className?: string; // Optional prop for the class
  image: HygraphImage;
  title: string;
  description: string;
  buttons: HygraphButton[];
}

const { className, image, title, description, buttons } = Astro.props;
import { cn } from "@/lib/utils";

const [primaryButton, secondaryButton] = buttons;
---

<section
  class={cn("relative bg-black h-[calc(100svh-88px)] flex flex-col", className)}
  data-type="splitColumn"
>
  {
    (
      <img
        src={image.url}
        class:list={cn(
          "static md:absolute h-full w-full md:w-1/2 right-0 object-cover"
        )}
        width={image.width}
        height={image.height}
      />
    )
  }
  <div
    class="container text-background mx-auto h-full static md:absolute inset-0 flex flex-col justify-center gap-8 py-10 md:py-0"
  >
    <div class="w-full md:w-1/2 md:pr-10 px-2">
      <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold">{title}</h1>
      <p class="text-2xl lg:text-3xl mt-4">{description}</p>
      {primaryButton && (
        <a href={primaryButton.url} class={cn(buttonVariants({ variant: "default" }), "mt-4")}>{primaryButton.text}</a>
      )}
      {secondaryButton && (
        <a href={secondaryButton.url} target="_blank" rel="noopener noreferrer" class={cn(buttonVariants({ variant: "outlineInverted" }), "mt-4")}>{secondaryButton.text}</a>
      )}
    </div>
  </div>
</section>
