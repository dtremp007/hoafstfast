---
import SplitColumn from "./SplitColumn.astro";
import TwoCards from "./TwoCards.astro";

export type SectionType = keyof typeof sectionComponents;

interface Props {
  type: SectionType;
  title: string;
  description: string;
  image: string;
}

const { type, title, description, image } = Astro.props;

const sectionComponents = {
  splitColumn: SplitColumn,
  twoCards: TwoCards,
};

const SectionComponent = sectionComponents[type];
---

<SectionComponent title={title} description={description} image={image} />
