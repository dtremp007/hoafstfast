---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Itinerario - Festival de Otoño Cuauhtémoc">
	<!-- Navigation -->
	<nav class="bg-white shadow-lg sticky top-0 z-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between items-center h-16">
				<!-- Logo -->
				<div class="flex-shrink-0">
					<a href="/" class="text-2xl font-bold text-festival-orange">FESTIVAL DE OTOÑO CUAUHTÉMOC</a>
				</div>

				<!-- Navigation Menu -->
				<div class="hidden md:block">
					<div class="ml-10 flex items-baseline space-x-4">
						<a href="/" class="text-gray-700 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Inicio</a>
						<a href="/itinerario" class="text-gray-900 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Itinerario</a>
						<a href="/historias" class="text-gray-700 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Historias de éxito</a>
						<a href="/contacto" class="text-gray-700 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Contáctanos</a>
					</div>
				</div>

				<!-- Contact Info -->
				<div class="hidden md:flex items-center space-x-4">
					<a href="tel:+5262510383-46" class="text-festival-orange hover:text-festival-brown flex items-center">
						<svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20">
							<path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
						</svg>
						+52 625 10383-46
					</a>
				</div>
			</div>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="bg-gradient-to-r from-festival-orange to-festival-brown text-white py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-5xl md:text-6xl font-bold mb-6">ITINERARIO DEL FESTIVAL</h1>
			<p class="text-xl">Próximamente - Detalles del programa completo</p>
		</div>
	</section>

	<!-- Content Section -->
	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<div class="bg-gray-100 rounded-lg p-12">
					<svg class="w-24 h-24 mx-auto mb-6 text-gray-400" fill="currentColor" viewBox="0 0 20 20">
						<path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"></path>
					</svg>
					<h2 class="text-3xl font-bold text-gray-700 mb-4">Itinerario en Desarrollo</h2>
					<p class="text-lg text-gray-600 mb-8">
						Estamos trabajando en el itinerario completo del festival. Pronto tendremos todos los detalles de horarios, actividades y eventos programados.
					</p>
					<div class="bg-festival-orange text-white px-6 py-3 rounded-lg inline-block">
						<p class="font-bold">¡Mantente atento para más información!</p>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="bg-gray-800 text-white py-8">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<p class="text-gray-400 mb-4">Derechos de autor y nombre de la empresa</p>
				<p class="text-sm text-gray-500">
					Con la tecnología de <a href="http://www.odoo.com" class="text-festival-orange hover:underline">Odoo</a> - El mejor <a href="http://www.odoo.com/app/ecommerce" class="text-festival-orange hover:underline">Comercio electrónico de código abierto</a>
				</p>
			</div>
		</div>
	</footer>
</Layout>
