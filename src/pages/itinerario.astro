---
import Layout from "../layouts/Layout.astro";
import { fetchEvents } from "../lib/hygraph";
import type { EventItem } from "../types/hygraph";
import EventCard from "../components/EventCard.astro";
import { cn } from "@/lib/utils";

const response = await fetchEvents();
const events = response.data.events;

// Group events by date
function groupEventsByDate(events: EventItem[]) {
  const grouped = new Map<string, EventItem[]>();

  events.forEach((event) => {
    const date = new Date(event.startTime);
    const dateKey = date.toDateString(); // e.g., "Mon Oct 14 2024"

    if (!grouped.has(dateKey)) {
      grouped.set(dateKey, []);
    }
    grouped.get(dateKey)!.push(event);
  });

  // Sort events within each day by start time
  grouped.forEach((dayEvents) => {
    dayEvents.sort(
      (a, b) =>
        new Date(a.startTime).getTime() - new Date(b.startTime).getTime()
    );
  });

  return grouped;
}

const groupedEvents = groupEventsByDate(events || []);
const sortedDates = Array.from(groupedEvents.keys()).sort(
  (a, b) => new Date(a).getTime() - new Date(b).getTime()
);

// Format date for display
function formatDate(dateString: string) {
  const date = new Date(dateString);
  return new Intl.DateTimeFormat("es-MX", {
    weekday: "long",
    month: "long",
    day: "numeric",
  }).format(date);
}

// Group a single day's events by starting local hour
function groupEventsByHour(dayEvents: EventItem[]) {
  const groups = new Map<number, EventItem[]>();
  dayEvents.forEach((ev) => {
    const d = new Date(ev.startTime);
    const hourStartMs = new Date(
      d.getFullYear(),
      d.getMonth(),
      d.getDate(),
      d.getHours(),
      0,
      0,
      0
    ).getTime();
    if (!groups.has(hourStartMs)) groups.set(hourStartMs, []);
    groups.get(hourStartMs)!.push(ev);
  });

  // Sort events within each hour by start time
  groups.forEach((list) =>
    list.sort(
      (a, b) =>
        new Date(a.startTime).getTime() - new Date(b.startTime).getTime()
    )
  );

  // Return entries sorted by hour ascending
  return Array.from(groups.entries()).sort((a, b) => a[0] - b[0]);
}

// Spanish hour label for subheaders
function formatHour(hourStartMs: number) {
  const date = new Date(hourStartMs);
  return new Intl.DateTimeFormat("es-MX", {
    hour: "numeric",
    minute: "2-digit",
  }).format(date);
}
---

<Layout title="Itinerario - Festival de Otoño Cuauhtémoc">
  <section class="py-12 px-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl font-bold text-center mb-10">Itinerario</h1>
      {
        events?.length === 0 ? (
          <p class="text-center text-muted-foreground">Próximamente…</p>
        ) : (
          <div class="space-y-12">
            {sortedDates.map((dateKey, index) => {
              const dayEvents = groupedEvents.get(dateKey)!;
              return (
                <div class="space-y-6">
                  <div class="text-center">
                    <h2 class="text-2xl font-semibold text-foreground mb-2">
                      {formatDate(dateKey)}
                    </h2>
                    <div class="w-24 h-1 bg-primary mx-auto rounded-full" />
                  </div>
                  <div class="space-y-10">
                    {groupEventsByHour(dayEvents).map(([hourKey, hourEvents]) => (
                      <div class="space-y-4">
                        <div class="flex items-center gap-3">
                          <div class="text-base font-medium text-muted-foreground">
                            {formatHour(hourKey)}
                          </div>
                          <div class="flex-1 h-px bg-border" />
                        </div>
                        <div
                          class={cn(
                            "grid gap-6",
                            hourEvents.length > 1 && "md:grid-cols-2 lg:grid-cols-3"
                          )}
                        >
                          {hourEvents.map((ev) => (
                            <EventCard
                              title={ev.title}
                              startTime={ev.startTime}
                              endTime={ev.endTime}
                            />
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })}
          </div>
        )
      }
    </div>
  </section>
</Layout>
