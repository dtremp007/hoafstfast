---
import Layout from "../layouts/Layout.astro";
import { fetchPageData } from "../lib/hygraph";
import type { Page } from "../types/hygraph";
import RenderSection from "../components/sections/ImageSection/RenderSection.astro";
import GallerySection from "../components/sections/GallerySection.astro";
import GridSection from "../components/sections/GridSection.astro";
import YouTubeSection from "../components/sections/YouTubeSection.astro";
import { buttonVariants } from "../components/Button.astro";

// Fetch page data from Hygraph
let pageData: Page | null = null;
try {
  const response = await fetchPageData({ slug: "home" });
  pageData = response.data.page;
} catch (error) {
  console.error("Error fetching page data:", error);
  // Fallback to default data if Hygraph is not available
}
---

<Layout
  title="Festival de Otoño Cuauhtémoc | Herbstfest (Hoafstfast)"
  description="Festival de Otoño (Herbstfest / Hoafstfast) en Cuauhtémoc, Chihuahua: música, arte, gastronomía y causa social. Evento cultural organizado por la comunidad menonita."
>
  <nav>
    <div class="container mx-auto flex justify-between items-center gap-16 p-4">
      <img
        src="/logo.png"
        alt="Festival de Otoño Cuauhtémoc"
        class="h-24 w-24"
      />
      <div class="flex items-center space-x-4">
        <a href="#contacto" class={buttonVariants({ variant: "default" })}>Contáctanos</a>
      </div>
    </div>
  </nav>
  <!-- Dynamic Sections from Hygraph -->
  {
    pageData && pageData.sections && pageData.sections.length > 0
      ? pageData.sections.map((section) =>
          section.__typename === "ImageSection" ? (
            <RenderSection section={section} />
          ) : section.__typename === "GridSection" ? (
            <GridSection section={section} />
          ) : section.__typename === "GallerySection" ? (
            <GallerySection section={section} />
          ) : section.__typename === "YouTubeSection" ? (
            <YouTubeSection section={section} />
          ) : null
        )
      : null
  }

  <!-- Contact Section -->
  <section class="py-16 bg-foreground text-background" id="contacto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h3 class="text-4xl font-bold text-center mb-12">Contáctanos</h3>

      <!-- Contact Information -->
      <div class="space-y-8">
        <div>
          <h4 class="text-2xl font-bold mb-6">Mi Empresa</h4>

          <div class="space-y-4">
            <div class="flex items-start">
              <svg
                class="w-6 h-6 mr-3 mt-1 text-festival-gold"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                  clip-rule="evenodd"></path>
              </svg>
              <p class="text-lg">
                Kilometro 32, Campo 12 B Corredor Comercial Manitoba
              </p>
            </div>

            <div class="flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-festival-gold"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                ></path>
              </svg>

              <a
                href="tel:+526251038346"
                class="text-lg"
                rel="noopener noreferrer">+52 (625) 103 8346</a
              >
            </div>

            <div class="flex items-center">
              <svg
                class="w-6 h-6 mr-3 text-festival-gold"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                ></path>
                <path
                  d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                ></path>
              </svg>
              <p class="text-lg">festivaldeotonocuauhtemoc@gmail.com</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer class="bg-foreground text-background py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">Made by David Rempel</div>
    </div>
  </footer>
</Layout>
