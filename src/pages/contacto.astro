---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contáctanos - Festival de Otoño Cuauhtémoc">
	<!-- Navigation -->
	<nav class="bg-white shadow-lg sticky top-0 z-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="flex justify-between items-center h-16">
				<!-- Logo -->
				<div class="flex-shrink-0">
					<a href="/" class="text-2xl font-bold text-festival-orange">FESTIVAL DE OTOÑO CUAUHTÉMOC</a>
				</div>

				<!-- Navigation Menu -->
				<div class="hidden md:block">
					<div class="ml-10 flex items-baseline space-x-4">
						<a href="/" class="text-gray-700 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Inicio</a>
						<a href="/itinerario" class="text-gray-700 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Itinerario</a>
						<a href="/historias" class="text-gray-700 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Historias de éxito</a>
						<a href="/contacto" class="text-gray-900 hover:text-festival-orange px-3 py-2 rounded-md text-sm font-medium">Contáctanos</a>
					</div>
				</div>

				<!-- Contact Info -->
				<div class="hidden md:flex items-center space-x-4">
					<a href="tel:+5262510383-46" class="text-festival-orange hover:text-festival-brown flex items-center">
						<svg class="w-5 h-5 mr-1" fill="currentColor" viewBox="0 0 20 20">
							<path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
						</svg>
						+52 625 10383-46
					</a>
				</div>
			</div>
		</div>
	</nav>

	<!-- Hero Section -->
	<section class="bg-gradient-to-r from-festival-orange to-festival-brown text-white py-20">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
			<h1 class="text-5xl md:text-6xl font-bold mb-6">Contáctanos</h1>
			<p class="text-xl">Estamos aquí para ayudarte con cualquier pregunta</p>
		</div>
	</section>

	<!-- Contact Section -->
	<section class="py-16 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid md:grid-cols-2 gap-12">
				<!-- Contact Form -->
				<div class="bg-gray-50 p-8 rounded-lg">
					<h2 class="text-3xl font-bold mb-6 text-festival-orange">Envíanos un mensaje</h2>
					<p class="mb-6 text-gray-700">
						Contáctenos sobre cualquier cosa relacionada con nuestra empresa o servicios. Haremos todo lo posible por responderle a la brevedad.
					</p>

					<form class="space-y-4">
						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Nombre *</label>
							<input type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-festival-orange">
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Número de teléfono</label>
							<input type="tel" value="+52" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-festival-orange">
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Correo electrónico *</label>
							<input type="email" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-festival-orange">
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Empresa</label>
							<input type="text" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-festival-orange">
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Asunto *</label>
							<input type="text" required class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-festival-orange">
						</div>

						<div>
							<label class="block text-sm font-medium text-gray-700 mb-2">Pregunta *</label>
							<textarea required rows="4" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-festival-orange"></textarea>
						</div>

						<button type="submit" class="w-full bg-festival-orange text-white py-3 px-6 rounded-md hover:bg-orange-600 transition-colors font-bold">
							Enviar
						</button>
					</form>
				</div>

				<!-- Contact Information -->
				<div class="space-y-8">
					<div>
						<h2 class="text-3xl font-bold mb-6 text-festival-orange">Información de Contacto</h2>

						<div class="space-y-6">
							<div class="flex items-start">
								<svg class="w-8 h-8 mr-4 mt-1 text-festival-orange" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
								</svg>
								<div>
									<h3 class="text-xl font-bold text-gray-800 mb-2">Dirección</h3>
									<p class="text-lg text-gray-600">Kilometro 32, campo 12 B corredor comercial manitoba</p>
								</div>
							</div>

							<div class="flex items-center">
								<svg class="w-8 h-8 mr-4 text-festival-orange" fill="currentColor" viewBox="0 0 20 20">
									<path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
								</svg>
								<div>
									<h3 class="text-xl font-bold text-gray-800 mb-2">Teléfono</h3>
									<p class="text-lg text-gray-600">+52 625-103-83-46</p>
								</div>
							</div>

							<div class="flex items-center">
								<svg class="w-8 h-8 mr-4 text-festival-orange" fill="currentColor" viewBox="0 0 20 20">
									<path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
									<path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
								</svg>
								<div>
									<h3 class="text-xl font-bold text-gray-800 mb-2">Email</h3>
									<p class="text-lg text-gray-600">festivaldeotonocuauhtemoc@gmail.com</p>
								</div>
							</div>
						</div>
					</div>

					<!-- Additional Contact Numbers -->
					<div class="bg-festival-orange bg-opacity-10 p-6 rounded-lg">
						<h3 class="text-xl font-bold mb-4 text-festival-orange">Otros Números de Contacto</h3>
						<div class="space-y-2">
							<p class="text-lg">+52 625 10383-46</p>
							<p class="text-lg">+520625 130 8343-</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="bg-gray-800 text-white py-8">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center">
				<p class="text-gray-400 mb-4">Derechos de autor y nombre de la empresa</p>
				<p class="text-sm text-gray-500">
					Con la tecnología de <a href="http://www.odoo.com" class="text-festival-orange hover:underline">Odoo</a> - El mejor <a href="http://www.odoo.com/app/ecommerce" class="text-festival-orange hover:underline">Comercio electrónico de código abierto</a>
				</p>
			</div>
		</div>
	</footer>
</Layout>
