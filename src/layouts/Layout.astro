---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Festival de Otoño Cuauhtémoc",
  description = "Unidos por la tradición, inspirados en la solidaridad",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/drone-shot-og.webp" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/drone-shot-og.webp" />

    <!-- JSON-LD Organization/Event -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Festival',
      name: 'Festival de Otoño Cuauhtémoc',
      alternateName: ['Herbstfest', 'Festival de Otono', 'Hoafstfast'],
      url: 'https://www.hoafstfast.com',
      image: ['https://www.hoafstfast.com/drone-shot-og.webp'],
      description,
      organizer: {
        '@type': 'Organization',
        name: 'Festival de Otoño Cuauhtémoc'
      },
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      startDate: '2025-09-26T10:00:00-06:00',
      endDate: '2025-09-28T22:00:00-06:00',
      eventSchedule: [
        {
          '@type': 'Schedule',
          startDate: '2025-09-26',
          startTime: '10:00',
          endTime: '22:00',
          scheduleTimezone: 'America/Chihuahua'
        },
        {
          '@type': 'Schedule',
          startDate: '2025-09-27',
          startTime: '09:00',
          endTime: '22:00',
          scheduleTimezone: 'America/Chihuahua'
        },
        {
          '@type': 'Schedule',
          startDate: '2025-09-28',
          startTime: '09:00',
          endTime: '22:00',
          scheduleTimezone: 'America/Chihuahua'
        }
      ],
      location: {
        '@type': 'Place',
        name: 'Campo 12B Corredor Comercial Manitoba, Chihuahua',
        address: {
          '@type': 'PostalAddress',
          streetAddress: 'Campo 12B',
          addressLocality: 'Cuauhtémoc',
          addressRegion: 'Chihuahua',
          addressCountry: 'MX'
        }
      }
    })} />
    <title>{title}</title>
  </head>
  <body >
    <slot />
  </body>
</html>
