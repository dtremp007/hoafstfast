---
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Festival de Otoño Cuauhtémoc",
  description = "Unidos por la tradición, inspirados en la solidaridad",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:image" content="/drone-shot-og.webp" />
    <title>{title}</title>
  </head>
  <body class="font-sans bg-gradient-to-br from-orange-50 to-amber-50">
    <slot />
  </body>
</html>
